# Patches must keep their exact bytes or `git apply` fails on checkout.
*.patch -text
*.diff -text

# Keep shell scripts and CI workflows LF regardless of platform.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf

*.py text eol=lf
*.md text

# Hengband runtime data files must use LF so Linux angband_fgets never turns \r into '?'
variants/hengband/lib/**/*.prf text eol=lf
variants/hengband/lib/**/*.txt text eol=lf
variants/hengband/lib/**/*.jsonc text eol=lf

