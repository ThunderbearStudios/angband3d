␀?qaaaa?␀␀␀␀␀␀␀␀␀€€€€€␀␀␀␀␀␀66␀?aaaaa?␀␀␀␀␀␀␀␀␀€€€€€␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀?aceiq?@␀␀␀␀␀␀€␀€€€€€␀␀␀␀␀0␀cccccc?␀␀␀␀␀␀␀␀␀␀␀␀␀␀€␀␀␀␀␀cccccc?␀␀␀␀␀␀␀␀␀␀␀␀␀␀€␀␀␀␀␀cccccc?␀␀␀␀␀␀␀␀␀␀␀␀␀␀€␀␀␀␀␀66␀cccccc?␀␀␀␀␀␀␀␀␀␀␀␀␀␀€␀␀␀␀␀cccccg?c>␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀``x|fff|x``␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀66␀cccccg?c>␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀9X15XB␀MKPATH=../../mk/
include $(MKPATH)buildsys.mk

DATA = 5x8x.fon 6x10x.fon 6x12x.fon 6x13x.fon 6x13xb.fon 7x13x.fon \
	7x13xb.fon 8x8x.fon 8x8xb.fon 8x12x.fon 8x12xb.fon 8x13x.fon 8x16x.fon \
	9x15x.fon 9x15xb.fon 10x14x.fon 10x14xb.fon 10x20x.fon 12x18x.fon \
	12x24x.fon 16x16x.fon 16x16xw.fon 16x16xw.woff 16x24x.fon
PACKAGE = fonts
MKPATH=../../mk/
include $(MKPATH)buildsys.mk

FILES = activation.txt artifact.txt body.txt blow_methods.txt \
 blow_effects.txt brand.txt chest_trap.txt class.txt constants.txt curse.txt \
 dungeon_profile.txt ego_item.txt flavor.txt hints.txt history.txt \
 monster.txt monster_base.txt monster_spell.txt names.txt object.txt \
 object_base.txt object_property.txt old_class.txt p_race.txt pain.txt pit.txt \
 player_property.txt player_timed.txt projection.txt quest.txt realm.txt \
 room_template.txt shape.txt slay.txt store.txt summon.txt terrain.txt \
 trap.txt ui_entry.txt ui_entry_base.txt ui_entry_renderer.txt \
 ui_knowledge.txt vault.txt visuals.txt world.txt

R1 = $(GAMEDATA_IN_LIB:true=$(FILES))
DATA = $(R1:false=)
R2 = $(GAMEDATA_IN_LIB:false=$(FILES))
CONFIG = $(R2:true=)

PACKAGE = gamedata
# File: activation.txt

# This file is used to initialize effects for random artifacts and traps

# === Understanding activation.txt ===

# name: effect name code
# aim: 1 if the effect requires aiming, 0 if not
# level: difficulty, an integer, for the activation
# power: relative power of the effect for object power calculation; also
#     used to calculate the recharge time when used for a random artifact
# effect: the effect name, followed by extra effect parameters if any.
# dice: dice for the random value used by the effect
# expr: details of expressions used in dice
# msg: activation message
# desc: activation description

name:CURE_POISON
aim:0
level:5
power:1
effect:CURE:POISONED
desc:neutralizes poison

name:CURE_BLINDNESS
aim:0
level:13
power:4
effect:CURE:BLIND
desc:cures blindness

name:CURE_PARANOIA
aim:0
level:8
power:2
effect:CURE:AFRAID
desc:removes your fear

name:CURE_CONFUSION
aim:0
level:13
power:4
effect:CURE:CONFUSED
desc:cures confusion

name:CURE_MIND
aim:0
level:18
power:8
effect:RESTORE_MANA
dice:20
effect:CURE:CONFUSED
effect:CURE:AFRAID
effect:CURE:IMAGE
effect:TIMED_INC:OPP_CONF
dice:12+6d10
desc:restores 20SP, cures confusion and hallucination, removes fear and grants you temporary resistance to confusion

name:CURE_BODY
aim:0
level:15
power:7
effect:HEAL_HP
dice:30
effect:CURE:STUN
effect:CURE:CUT
effect:CURE:POISONED
effect:CURE:BLIND
desc:heals 30 hitpoints, cut damage, and cures stunning, poison and blindness

name:CURE_LIGHT
aim:0
level:12
power:3
effect:HEAL_HP
dice:20
effect:CURE:BLIND
effect:TIMED_DEC:CUT
dice:20
effect:TIMED_DEC:CONFUSED
dice:20
desc:heals 20 hitpoints, some cut damage, makes you a little less confused, and cures blindness

name:CURE_SERIOUS
aim:0
level:25
power:6
msg:Your {kind} radiate{s} deep purple...
effect:HEAL_HP
dice:40
effect:CURE:BLIND
effect:CURE:CUT
effect:CURE:CONFUSED
desc:heals 40 hitpoints, cut damage, and cures blindness and confusion

name:CURE_CRITICAL
aim:0
level:40
power:9
effect:HEAL_HP
dice:60
effect:CURE:BLIND
effect:CURE:CUT
effect:CURE:POISONED
effect:CURE:STUN
effect:CURE:AMNESIA
effect:CURE:CONFUSED
desc:heals 60 hitpoints, cut damage, and cures stunning, poisoning, blindness, and confusion

name:CURE_FULL
aim:0
level:80
power:12
