{
  "$schema": "./schemas/engine-manifest.schema.json",
  "version": "12.1.0",
  "default_realm": "angband",
  "tier_groups": {
    "tier_1_native": ["angband", "silq", "frogcomposband", "hengband"],
    "tier_2_cartridges": ["ryod", "nethack", "dcss", "brogue", "rogue"],
    "browser_worker_realms": ["angband", "ryod", "nethack", "dcss", "brogue", "rogue"]
  },
  "realms": {
    "angband": {
      "id": "angband",
      "name": "Vanilla Angband 4.2.6",
      "tagline": "The Classic Tolkien Descent",
      "version": "4.2.6",
      "lineage": "Vanilla Angband Canon",
      "binary": {
        "win_x64": "engine/build/game/angband.exe",
        "linux_x64": "engine/build/game/angband"
      },
      "cli": {
        "frontend_switch": "-mbridge",
        "save_token_format": "-u{name}",
        "save_dir_switch": "-dsave={path}",
        "panic_dir_switch": "-dpanic={path}",
        "new_char_switch": "-n",
        "env_vars": {
          "ANGBAND_PATH": "engine/lib"
        }
      },
      "save_system": {
        "magic_signature": "SaveVANILLA",
        "directory": "engine/build/game/lib/save",
        "extension": ".sav"
      },
      "capabilities": {
        "wilderness": false,
        "multitown": false,
        "stealth_engine": false,
        "songs_of_power": false,
        "monster_races": false,
        "quests": false,
        "mounts": false,
        "depth_max": 100
      },
      "terminal": {
        "default_width": 80,
        "default_height": 24,
        "supports_dynamic_resize": false
      },
      "theme": {
        "primary_color": "#38bdf8",
        "secondary_color": "#0284c7",
        "voice_profile": "Old British Scholar",
        "voice_id": "en-GB-RyanNeural",
        "tradition": "classic",
        "ui_badges": ["Tolkien Canon", "Bit-for-Bit 4.2.6", "100 Dungeon Levels", "Morgoth"]
      },
      "lore": "The original descent into the pits of Angband to defeat Morgoth, Lord of Darkness. Standard 4.2.6 rules and bit-for-bit mechanics."
    },
