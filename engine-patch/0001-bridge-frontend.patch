+		monster_desc(mname, sizeof(mname), target_mon, MDESC_STANDARD);
+		bj_kv_string(fp, "name", mname);
+		fputc(',', fp);
+		bj_kv_int(fp, "hp", target_mon->hp);
+		fputc(',', fp);
+		bj_kv_int(fp, "hp_max", target_mon->maxhp);
+		fputc(',', fp);
+		bj_kv_int(fp, "pct", (int)(100L * target_mon->hp / (target_mon->maxhp ? target_mon->maxhp : 1)));
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", monster_health_attr());
+		fputc('}', fp);
+	}
+
+	/* Level Feeling */
+	if (bridge_in_play() && OPT(player, birth_feelings) && player->depth > 0 && cave->feeling_squares >= z_info->feeling_need) {
+		fputc(',', fp);
+		bj_key(fp, "feeling");
+		fputc('{', fp);
