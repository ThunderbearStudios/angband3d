+ * Command input
+ * ------------------------------------------------------------------------ */
+
+/**
+ * Translate a key name into a keycode. Returns 0 if unrecognised.
+ */
+static keycode_t bridge_keycode(const char *spec)
+{
+	if (!spec || !*spec) return 0;
+
+	if (my_stricmp(spec, "left") == 0 || my_stricmp(spec, "arrowleft") == 0) return ARROW_LEFT;
+	if (my_stricmp(spec, "right") == 0 || my_stricmp(spec, "arrowright") == 0) return ARROW_RIGHT;
+	if (my_stricmp(spec, "up") == 0 || my_stricmp(spec, "arrowup") == 0) return ARROW_UP;
+	if (my_stricmp(spec, "down") == 0 || my_stricmp(spec, "arrowdown") == 0) return ARROW_DOWN;
+	if (my_stricmp(spec, "space") == 0 || streq(spec, " ")) return ' ';
+	if (my_stricmp(spec, "enter") == 0 || my_stricmp(spec, "return") == 0) return KC_ENTER;
+	if (my_stricmp(spec, "escape") == 0 || my_stricmp(spec, "esc") == 0) return ESCAPE;
+	if (my_stricmp(spec, "tab") == 0) return KC_TAB;
+	if (my_stricmp(spec, "backspace") == 0) return KC_BACKSPACE;
+	if (my_stricmp(spec, "delete") == 0) return KC_DELETE;
+	if (my_stricmp(spec, "home") == 0) return KC_HOME;
+	if (my_stricmp(spec, "end") == 0) return KC_END;
+	if (my_stricmp(spec, "pageup") == 0 || my_stricmp(spec, "pgup") == 0) return KC_PGUP;
+	if (my_stricmp(spec, "pagedown") == 0 || my_stricmp(spec, "pgdn") == 0) return KC_PGDOWN;
+
+	if ((spec[0] == 'C' || spec[0] == 'c') && spec[1] == '-' && spec[2] && !spec[3]) {
+		return KTRL(spec[2]);
+	}
+
+	if (strlen(spec) == 1) {
+		return (keycode_t)(unsigned char)spec[0];
+	}
+
+	return 0;
+}
+
+
+static bool save_pending = false;
+
+/**
+ * Handle one command line. Returns the number of keypresses queued.
+ */
+static int bridge_handle(char *line)
+{
+	char *cmd, *rest;
+	bool is_json_save = (line && strstr(line, "\"t\":\"save\"") != NULL);
+
+	cmd = strtok(line, " \t");
+	if (!cmd) return 0;
+	rest = strtok(NULL, "");
+
+	if (streq(cmd, "key")) {
+		keycode_t k = bridge_keycode(rest);
+		if (k) {
+			Term_keypress(k, 0);
+			return 1;
+		}
+		emit_event("error", "bad key");
+		return 0;
+	}
+
+	if (streq(cmd, "keys")) {
+		int n = 0;
+		if (rest) {
+			while (*rest) {
+				Term_keypress((keycode_t)(unsigned char)*rest++, 0);
+				n++;
+			}
+		}
+		return n;
+	}
+
+	if (streq(cmd, "map")) {
+		emit_map_data = !(rest && streq(rest, "off"));
+		emit_event("ok", emit_map_data ? "map on" : "map off");
+		return 0;
+	}
+
+	if (streq(cmd, "frame")) {
+		emit_frame();
+		return 0;
+	}
+
+	if (streq(cmd, "quit")) {
+		emit_event("bye", NULL);
+		quit(NULL);
+		return 0;
+	}
+
+	if (streq(cmd, "ping")) {
+		emit_event("pong", NULL);
+		return 0;
+	}
+
+	if (streq(cmd, "save") || is_json_save) {
+		if (bridge_in_play() && (!player || !player->is_dead) && savefile[0]) {
+			bool ok = savefile_save(savefile);
+			emit_event("ok", ok ? "saved" : "save_failed");
+		} else if (!bridge_in_play()) {
+			save_pending = true;
+			emit_event("ok", "save_pending");
+		} else {
+			emit_event("error", (player && player->is_dead) ? "player is dead" : "not in play");
+		}
+		return 0;
+	}
+
+	if (streq(cmd, "banish")) {
+		if (cave) {
+			int i;
+			for (i = cave_monster_max(cave) - 1; i >= 1; i--) {
+				if (rest && *rest) {
+					struct monster *mon = cave_monster(cave, i);
+					if (!mon || !mon->race || !mon->race->name || !strstr(mon->race->name, rest)) continue;
+				}
+				delete_monster_idx(cave, i);
+			}
+			emit_event("ok", "banished");
+		} else {
+			emit_event("ok", "no cave");
+		}
+		return 0;
+	}
+
+	if (cmd[0] == '#') return 0;
+
+	emit_event("error", "unknown command");
+	return 0;
+}
