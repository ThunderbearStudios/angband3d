+/**
+ * Input state, so a client knows whether the game wants a normal command or is
+ * showing a menu, store or prompt that only exists on the terminal channel.
+ */
+static bool bridge_eval_cmd_prereq(const struct cmd_info *ci)
+{
+	if (!ci || !ci->prereq) return true;
+	if (!player) return false;
+	if (ci->prereq == player_can_fire_prereq) return player_can_fire(player, false);
+	if (ci->prereq == player_can_read_prereq) return player_can_read(player, false);
+	if (ci->prereq == player_can_refuel_prereq) return player_can_refuel(player, false);
+	if (ci->prereq == player_can_cast_prereq) return player_can_cast(player, false);
+	if (ci->prereq == player_can_study_prereq) return player_can_study(player, false);
+	return true;
+}
