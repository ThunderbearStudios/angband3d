+static void bridge_get_row0_text(char *buf, size_t buflen)
+{
+	buf[0] = '\0';
+	if (!Term || !Term->scr || !Term->scr->c || !Term->scr->c[0]) return;
+	int w = Term->wid;
+	if (w <= 0) return;
+	while (w > 0 && Term->scr->c[0][w - 1] == L' ') w--;
+	size_t len = 0;
+	for (int i = 0; i < w && len + 1 < buflen; i++) {
+		wchar_t wc = Term->scr->c[0][i];
+		if (wc < 128) {
+			buf[len++] = (char)wc;
+		} else {
+			buf[len++] = '?';
+		}
+	}
+	buf[len] = '\0';
+}
