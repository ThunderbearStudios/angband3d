+	case CMD_USE_WAND: return "aim";
+	case CMD_USE_STAFF: return "use_staff";
+	case CMD_USE_ROD: return "zap";
+	case CMD_ACTIVATE: return "activate";
+	case CMD_FIRE: return "fire";
+	case CMD_THROW: return "throw";
+	case CMD_WIELD: return "wield";
+	case CMD_TAKEOFF: return "takeoff";
+	case CMD_DROP: return "drop";
+	case CMD_INSCRIBE: return "inscribe";
+	case CMD_UNINSCRIBE: return "uninscribe";
+	case CMD_REFILL: return "refill";
+	case CMD_BROWSE_SPELL: return "browse";
+	case CMD_STUDY: return "study";
+	case CMD_CAST: return "cast";
+	case CMD_IGNORE: return "ignore";
+	case CMD_USE: return "use";
+	case CMD_PICKUP: return "pickup";
+	case CMD_DISARM: return "disarm";
+	case CMD_REST: return "rest";
+	case CMD_TUNNEL: return "tunnel";
+	case CMD_OPEN: return "open";
+	case CMD_CLOSE: return "close";
+	case CMD_ALTER: return "alter";
+	case CMD_WALK: return "walk";
+	case CMD_JUMP: return "jump";
+	default: return "";
