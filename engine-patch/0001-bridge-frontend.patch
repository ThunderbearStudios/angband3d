+			fputc(',', fp);
+			bj_kv_string(fp, "label", letter_str);
+			fputc(',', fp);
+			uint32_t vm = 0, im = 0;
+			bridge_obj_verbs(obj, true, &vm, &im);
+			bj_kv_int(fp, "vm", (long)vm);
+			fputc(',', fp);
+			bj_kv_int(fp, "im", (long)im);
+			if (obj->note != 0) {
+				const char *note_str = quark_str(obj->note);
+				if (note_str && *note_str) {
+					fputc(',', fp);
+					bj_kv_string(fp, "inscription", note_str);
+				}
+			}
+			fputc(',', fp);
+			bj_kv_string(fp, "slot_name", player->body.slots[i].name ? player->body.slots[i].name : "");
+			fputc(',', fp);
+			const char *mention = equip_mention(player, i);
+			bj_kv_string(fp, "mention", mention ? mention : "");
+			fputc(',', fp);
+			char desc[160];
+			object_desc(desc, sizeof(desc), obj, ODESC_FULL, player);
+			bj_kv_string(fp, "name", desc);
+			fputc(',', fp);
+			bj_kv_int(fp, "tval", obj->tval);
+			fputc(',', fp);
+			bj_kv_int(fp, "sval", obj->sval);
+			fputc(',', fp);
+			bj_kv_int(fp, "number", obj->number);
+			fputc(',', fp);
+			bj_kv_int(fp, "weight", obj->weight);
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", obj->kind && obj->kind->base ? obj->kind->base->attr : COLOUR_WHITE);
+			fputc('}', fp);
+		}
+	}
+	fputc(']', fp);
+
+	/* Inventory list with full descriptions */
+	fputc(',', fp);
+	bj_key(fp, "inventory");
+	fputc('[', fp);
+	bool has_inv = false;
+	if (player->upkeep && player->upkeep->inven && z_info) {
+		for (int i = 0; i < z_info->pack_size; i++) {
+			struct object *obj = player->upkeep->inven[i];
+			if (!obj) continue;
+			if (has_inv) fputc(',', fp);
+			has_inv = true;
+			fputc('{', fp);
+			bj_kv_int(fp, "slot", i);
+			fputc(',', fp);
+			char letter_str[2];
+			letter_str[0] = (i < (int)sizeof(bridge_letters_nohjkl) - 1) ? bridge_letters_nohjkl[i] : '?';
+			letter_str[1] = '\0';
+			bj_kv_string(fp, "letter", letter_str);
+			fputc(',', fp);
+			bj_kv_string(fp, "label", letter_str);
+			fputc(',', fp);
+			uint32_t vm = 0, im = 0;
+			bridge_obj_verbs(obj, false, &vm, &im);
+			bj_kv_int(fp, "vm", (long)vm);
+			fputc(',', fp);
+			bj_kv_int(fp, "im", (long)im);
+			if (obj->note != 0) {
+				const char *note_str = quark_str(obj->note);
+				if (note_str && *note_str) {
+					fputc(',', fp);
+					bj_kv_string(fp, "inscription", note_str);
+				}
+			}
+			fputc(',', fp);
+			char desc[160];
+			object_desc(desc, sizeof(desc), obj, ODESC_FULL, player);
+			bj_kv_string(fp, "name", desc);
+			fputc(',', fp);
+			bj_kv_int(fp, "tval", obj->tval);
+			fputc(',', fp);
+			bj_kv_int(fp, "sval", obj->sval);
+			fputc(',', fp);
+			bj_kv_int(fp, "number", obj->number);
+			fputc(',', fp);
+			bj_kv_int(fp, "weight", obj->weight);
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", obj->kind && obj->kind->base ? obj->kind->base->attr : COLOUR_WHITE);
+			fputc('}', fp);
+		}
+	}
+	fputc(']', fp);
+
+	/* Quiver list with full descriptions */
+	fputc(',', fp);
+	bj_key(fp, "quiver");
+	fputc('[', fp);
+	bool has_quiv = false;
+	if (player->upkeep && player->upkeep->quiver && z_info) {
+		for (int i = 0; i < z_info->quiver_size; i++) {
+			struct object *obj = player->upkeep->quiver[i];
+			if (!obj) continue;
+			if (has_quiv) fputc(',', fp);
+			has_quiv = true;
+			fputc('{', fp);
+			bj_kv_int(fp, "slot", i);
+			fputc(',', fp);
+			char label[8];
+			snprintf(label, sizeof(label), "%d", i);
+			bj_kv_string(fp, "letter", label);
+			fputc(',', fp);
+			bj_kv_string(fp, "label", label);
+			fputc(',', fp);
+			uint32_t vm = 0, im = 0;
+			bridge_obj_verbs(obj, false, &vm, &im);
+			bj_kv_int(fp, "vm", (long)vm);
+			fputc(',', fp);
+			bj_kv_int(fp, "im", (long)im);
+			if (obj->note != 0) {
+				const char *note_str = quark_str(obj->note);
+				if (note_str && *note_str) {
+					fputc(',', fp);
+					bj_kv_string(fp, "inscription", note_str);
+				}
+			}
+			fputc(',', fp);
+			char desc[160];
+			object_desc(desc, sizeof(desc), obj, ODESC_FULL, player);
+			bj_kv_string(fp, "name", desc);
+			fputc(',', fp);
+			bj_kv_int(fp, "tval", obj->tval);
+			fputc(',', fp);
+			bj_kv_int(fp, "sval", obj->sval);
+			fputc(',', fp);
+			bj_kv_int(fp, "number", obj->number);
+			fputc(',', fp);
+			bj_kv_int(fp, "weight", obj->weight);
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", obj->kind && obj->kind->base ? obj->kind->base->attr : COLOUR_WHITE);
+			fputc('}', fp);
+		}
+	}
+	fputc(']', fp);
+
+	fputc('}', fp);
+}
