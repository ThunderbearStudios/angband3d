+static void emit_monsters(FILE *fp)
+{
+	int i;
+
+	fputc('[', fp);
+	for (i = 0; i < mon_count; i++) {
+		struct monster *mon = NULL;
+
+		if (cave && mon_buf[i].idx < (uint32_t)cave->mon_max) {
+			mon = cave_monster(cave, mon_buf[i].idx);
+		}
+
+		if (i) fputc(',', fp);
+		fputc('{', fp);
+		bj_kv_int(fp, "id", mon_buf[i].idx);
+		fputc(',', fp);
+		bj_kv_int(fp, "y", mon_buf[i].y);
+		fputc(',', fp);
+		bj_kv_int(fp, "x", mon_buf[i].x);
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", mon_buf[i].attr);
+		fputc(',', fp);
+		bj_key(fp, "glyph");
+		bj_wstring(fp, &mon_buf[i].glyph, 1);
+
+		if (mon && mon->race) {
+			fputc(',', fp);
+			bj_kv_string(fp, "race", mon->race->name);
+			fputc(',', fp);
+			bj_kv_int(fp, "race_level", mon->race->level);
+			fputc(',', fp);
+			bj_kv_int(fp, "hp", mon->hp);
+			fputc(',', fp);
+			bj_kv_int(fp, "hp_max", mon->maxhp);
+			if (monster_is_invisible(mon) || rf_has(mon->race->flags, RF_INVISIBLE)) {
+				fputc(',', fp);
+				bj_kv_bool(fp, "invisible", true);
+			}
+			if (mflag_has(mon->mflag, MFLAG_MARK)) {
+				fputc(',', fp);
+				bj_kv_bool(fp, "detected", true);
+			}
+			if (cave && (!square_isview(cave, mon->grid) || !square_isseen(cave, mon->grid) || !square_islit(cave, mon->grid))) {
+				fputc(',', fp);
+				bj_kv_bool(fp, "unlit", true);
+			}
+			if (mon->m_timed[MON_TMD_SLEEP] > 0) {
+				fputc(',', fp);
+				bj_kv_bool(fp, "asleep", true);
+			}
+			if (mon->m_timed[MON_TMD_FEAR] > 0 || rf_has(mon->race->flags, RF_FRIGHTENED)) {
+				fputc(',', fp);
+				bj_kv_bool(fp, "afraid", true);
+			}
+			if (mon->m_timed[MON_TMD_CONF] > 0) {
+				fputc(',', fp);
+				bj_kv_bool(fp, "confused", true);
+			}
+			if (mon->m_timed[MON_TMD_STUN] > 0) {
+				fputc(',', fp);
+				bj_kv_bool(fp, "stunned", true);
+			}
+		}
+		fputc('}', fp);
+	}
+	fputc(']', fp);
+}
