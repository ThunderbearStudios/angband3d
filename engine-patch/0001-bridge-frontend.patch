+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+EM_ASYNC_JS(int, wasm_bridge_get_command, (char *buf, int maxlen), {
+	return await new Promise((resolve) => {
+		Module.commandResolver = (cmd) => {
+			if (!cmd) {
+				resolve(0);
+				return;
+			}
+			stringToUTF8(cmd, buf, maxlen);
+			resolve(1);
+		};
+		if (Module.onAwaitingInput) {
+			Module.onAwaitingInput();
+		}
+	});
+})
+#endif
