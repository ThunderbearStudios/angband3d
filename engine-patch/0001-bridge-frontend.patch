+static uint32_t compute_spell_sig(void)
+{
+	if (!player || !player->class || player->class->magic.total_spells == 0) return 0;
+
+	uint32_t sig = 0x5a17;
+	sig = sig * 31 + player->lev;
+	sig = sig * 31 + player->msp;
+	sig = sig * 31 + player->csp;
+	sig = sig * 31 + (player->timed[TMD_BLIND] > 0 ? 1 : 0);
+	sig = sig * 31 + (player->timed[TMD_CONFUSED] > 0 ? 1 : 0);
+
+	for (int s = 0; s < STAT_MAX; s++) {
+		sig = sig * 31 + player->stat_cur[s];
+		sig = sig * 31 + player->state.stat_ind[s];
+	}
+
+	if (player->spell_flags) {
+		for (int i = 0; i < player->class->magic.total_spells; i++) {
+			sig = sig * 31 + player->spell_flags[i];
+		}
+	}
+
+	if (player->upkeep && player->upkeep->inven && z_info) {
+		for (int i = 0; i < z_info->pack_size; i++) {
+			struct object *obj = player->upkeep->inven[i];
+			if (obj && obj_can_browse(obj)) {
+				sig = sig * 31 + i;
+				sig = sig * 31 + obj->tval;
+				sig = sig * 31 + obj->sval;
+			}
+		}
+	}
+
+	return (sig == 0) ? 1 : sig;
+}
+
+static uint32_t last_spell_sig = 0;
+
+static void emit_spells(void)
+{
+	FILE *fp = stdout;
+
+	if (!bridge_in_play()) return;
+	if (!player || !player->class || player->class->magic.total_spells == 0) return;
+	if (!player->upkeep || !player->upkeep->inven || !z_info) return;
+
+	uint32_t sig = compute_spell_sig();
+	if (sig == 0 || sig == last_spell_sig) return;
+	last_spell_sig = sig;
+
+	fputc('{', fp);
+	bj_kv_string(fp, "t", "spells");
+	fputc(',', fp);
+	bj_key(fp, "list");
+	fputc('[', fp);
+
+	bool first_spell = true;
+	for (int i = 0; i < z_info->pack_size; i++) {
+		struct object *obj = player->upkeep->inven[i];
+		if (!obj || !obj_can_browse(obj)) continue;
+
+		const struct class_book *book = player_object_to_book(player, obj);
+		if (!book || book->num_spells <= 0) continue;
+
+		char book_letter[2];
+		book_letter[0] = (i < (int)sizeof(bridge_letters_nohjkl) - 1) ? bridge_letters_nohjkl[i] : '?';
+		book_letter[1] = '\0';
+
+		for (int j = 0; j < book->num_spells; j++) {
+			const struct class_spell *cs = &book->spells[j];
+			int sidx = cs->sidx;
+
+			if (!first_spell) fputc(',', fp);
+			first_spell = false;
+
+			char spell_letter[2];
+			spell_letter[0] = (j < (int)sizeof(bridge_letters_nohjkl) - 1) ? bridge_letters_nohjkl[j] : '?';
+			spell_letter[1] = '\0';
+
+			fputc('{', fp);
+			bj_kv_string(fp, "book", book_letter);
+			fputc(',', fp);
+			bj_kv_int(fp, "idx", sidx);
+			fputc(',', fp);
+			bj_kv_string(fp, "letter", spell_letter);
+			fputc(',', fp);
+			bj_kv_string(fp, "name", cs->name ? cs->name : "");
+			fputc(',', fp);
+			bj_kv_int(fp, "level", cs->slevel);
+			fputc(',', fp);
+			bj_kv_int(fp, "mana", cs->smana);
+			fputc(',', fp);
+			bj_kv_int(fp, "fail", (long)spell_chance(sidx));
+			fputc(',', fp);
+			bj_kv_bool(fp, "castable", spell_okay_to_cast(player, sidx));
+			fputc(',', fp);
+			bj_kv_bool(fp, "aim", spell_needs_aim(sidx));
+			fputc('}', fp);
+		}
+	}
+
+	fputc(']', fp);
+	fputc('}', fp);
+	fputc('\n', fp);
+	fflush(fp);
+}
