+		uint16_t mon_feeling = cave->feeling - (10 * obj_feeling);
+		bj_kv_int(fp, "obj", obj_feeling);
+		fputc(',', fp);
+		bj_kv_int(fp, "mon", mon_feeling);
+		fputc('}', fp);
+	}
+
+	/* Equipment list with full descriptions */
+	fputc(',', fp);
+	bj_key(fp, "equipment");
+	fputc('[', fp);
+	bool has_eq = false;
+	if (player->body.slots) {
+		for (int i = 0; i < player->body.count; i++) {
+			struct object *obj = player->body.slots[i].obj;
+			if (!obj) continue;
+			if (has_eq) fputc(',', fp);
+			has_eq = true;
+			fputc('{', fp);
+			bj_kv_int(fp, "slot", i);
+			fputc(',', fp);
+			char letter_str[2];
+			letter_str[0] = (i < (int)sizeof(bridge_letters_nohjkl) - 1) ? bridge_letters_nohjkl[i] : '?';
