+/**
+ * ------------------------------------------------------------------------
+ * Prompt and Hook State
+ * ------------------------------------------------------------------------ */
+
+struct bridge_prompt_entry {
+	const char *kind;
+	char text[160];
+	char verb[32];
+	const char *src;
+};
+
+#define BRIDGE_PROMPT_STACK_MAX 4
+static struct bridge_prompt_entry prompt_stack[BRIDGE_PROMPT_STACK_MAX];
+static int prompt_stack_depth = 0;
+
+static void prompt_push(const char *kind, const char *text, const char *verb, const char *src)
+{
+	if (prompt_stack_depth < BRIDGE_PROMPT_STACK_MAX) {
+		prompt_stack[prompt_stack_depth].kind = kind ? kind : "";
+		my_strcpy(prompt_stack[prompt_stack_depth].text, text ? text : "", sizeof(prompt_stack[prompt_stack_depth].text));
+		my_strcpy(prompt_stack[prompt_stack_depth].verb, verb ? verb : "", sizeof(prompt_stack[prompt_stack_depth].verb));
+		prompt_stack[prompt_stack_depth].src = src ? src : "hook";
+	}
+	prompt_stack_depth++;
+}
+
+static void prompt_pop(void)
+{
+	if (prompt_stack_depth > 0) {
+		prompt_stack_depth--;
+	}
+}
