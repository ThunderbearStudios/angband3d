+
+const char help_bridge[] = "JSON state bridge, subopts -nomap";
+
+errr init_bridge(int argc, char *argv[])
+{
+	int i;
+	FILE *fp = stdout;
+
+	for (i = 1; i < argc; i++) {
+		if (streq(argv[i], "-nomap")) {
+			emit_map_data = false;
+			continue;
+		}
+	}
+
+	/*
+	 * main.c only does this under UNIX, and the Windows front end bypasses
+	 * main.c entirely, so on Windows nothing creates the save directory and
+	 * every save fails. Do it here rather than patching main.c, to keep the
+	 * fork rebasable.
+	 */
+	create_needed_dirs();
+
+	/*
+	 * If starting a new game (-n), remove any stale panic save for this savefile
+	 * so start_game() in ui-game.c does not get stuck prompting "A panic save exists. Use it?".
+	 */
+	if (savefile[0]) {
+		for (i = 1; i < argc; i++) {
+			if (streq(argv[i], "-n")) {
+				char pbuf[1024];
+				savefile_get_panic_name(pbuf, sizeof(pbuf), savefile);
+				if (pbuf[0] && file_exists(pbuf)) {
+					file_delete(pbuf);
+				}
+				break;
+			}
+		}
+	}
+
+	term_data_link(0);
+	bridge_ensure_hooks();
+
+	fputc('{', fp);
+	bj_kv_string(fp, "t", "hello");
+	fputc(',', fp);
+	bj_kv_int(fp, "protocol", BRIDGE_PROTOCOL);
+	fputc(',', fp);
+	bj_kv_string(fp, "build", buildid);
+	fputc(',', fp);
+	bj_kv_string(fp, "savefile", savefile);
+	fputc(',', fp);
+	bj_kv_string(fp, "save_dir", ANGBAND_DIR_SAVE ? ANGBAND_DIR_SAVE : "");
+	fputc('}', fp);
+	fputc('\n', fp);
+	fflush(fp);
+
+	return 0;
+}
+
+#endif /* USE_BRIDGE */
