+static const char *bridge_cmd_info_id(const struct cmd_info *ci)
+{
+	const char *v = bridge_cmd_verb(ci->cmd);
+	if (v && *v) return v;
+	if (!ci->desc) return "unknown";
+	if (strstr(ci->desc, "equipment")) return "equip";
+	if (strstr(ci->desc, "inventory")) return "inven";
+	if (strstr(ci->desc, "quiver listing")) return "quiver";
+	if (strstr(ci->desc, "nearest")) return "fire_nearest";
+	if (strstr(ci->desc, "closest")) return "target_closest";
+	if (strstr(ci->desc, "Target monster")) return "target";
+	if (strstr(ci->desc, "Look")) return "look";
+	if (strstr(ci->desc, "Rest")) return "rest";
+	if (strstr(ci->desc, "Examine")) return "examine";
+	return ci->desc;
+}
+
+static const char *bridge_cmd_target(const struct cmd_info *ci)
+{
+	cmd_code c = ci->cmd;
+	switch (c) {
+	case CMD_QUAFF:
+	case CMD_READ_SCROLL:
+	case CMD_EAT:
+	case CMD_USE_WAND:
+	case CMD_USE_STAFF:
+	case CMD_USE_ROD:
+	case CMD_ACTIVATE:
+	case CMD_WIELD:
+	case CMD_TAKEOFF:
+	case CMD_DROP:
+	case CMD_INSCRIBE:
+	case CMD_UNINSCRIBE:
+	case CMD_REFILL:
+	case CMD_IGNORE:
+	case CMD_USE:
+		return "item";
+	case CMD_FIRE:
+	case CMD_THROW:
+		return "item+dir";
+	case CMD_BROWSE_SPELL:
+	case CMD_STUDY:
+	case CMD_CAST:
+		return "spell";
+	case CMD_OPEN:
+	case CMD_CLOSE:
+	case CMD_TUNNEL:
+	case CMD_DISARM:
+	case CMD_ALTER:
+	case CMD_WALK:
+	case CMD_JUMP:
+		return "dir";
+	default:
+		if (ci->desc) {
+			if (strstr(ci->desc, "listing") || strstr(ci->desc, "character") || strstr(ci->desc, "messages") || strstr(ci->desc, "knowledge"))
+				return "screen";
+			if (strstr(ci->desc, "Target") || strstr(ci->desc, "nearest"))
+				return "target";
+			if (strstr(ci->desc, "Look"))
+				return "dir";
+		}
+		return "none";
+	}
+}
