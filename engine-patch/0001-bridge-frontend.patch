diff --git a/src/bridge-json.c b/src/bridge-json.c
new file mode 100644
index 000000000..bcc704105
--- /dev/null
+++ b/src/bridge-json.c
@@ -0,0 +1,117 @@
+/**
+ * \file bridge-json.c
+ * \brief Minimal JSON output helpers for the "bridge" front end.
+ *
+ * Copyright (c) 2026 angband3d contributors
+ *
+ * This work is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, version 2.
+ */
+
+#include "angband.h"
+#include "bridge-json.h"
+
+void bj_codepoint(FILE *fp, uint32_t cp)
+{
+	switch (cp) {
+	case '"':  fputs("\\\"", fp); return;
+	case '\\': fputs("\\\\", fp); return;
+	case '\b': fputs("\\b", fp); return;
+	case '\f': fputs("\\f", fp); return;
+	case '\n': fputs("\\n", fp); return;
+	case '\r': fputs("\\r", fp); return;
+	case '\t': fputs("\\t", fp); return;
+	default: break;
+	}
+
+	if (cp >= 0x20 && cp < 0x7f) {
+		fputc((int)cp, fp);
+	} else if (cp <= 0xffff) {
+		fprintf(fp, "\\u%04x", (unsigned)cp);
+	} else if (cp <= 0x10ffff) {
+		/* Encode as a UTF-16 surrogate pair. */
+		uint32_t v = cp - 0x10000;
+		fprintf(fp, "\\u%04x\\u%04x",
+			(unsigned)(0xd800 + (v >> 10)),
+			(unsigned)(0xdc00 + (v & 0x3ff)));
+	} else {
+		fputs("\\ufffd", fp);
+	}
+}
+
+void bj_string(FILE *fp, const char *s)
+{
+	fputc('"', fp);
+	if (s) {
+		const unsigned char *p = (const unsigned char *)s;
+		while (*p) {
+			uint32_t cp = 0;
+			if (*p < 0x80) {
+				cp = *p++;
+			} else if ((*p & 0xe0) == 0xc0) {
+				if ((p[1] & 0xc0) == 0x80) {
+					cp = ((uint32_t)(p[0] & 0x1f) << 6) | (uint32_t)(p[1] & 0x3f);
+					p += 2;
+				} else {
+					cp = *p++;
+				}
+			} else if ((*p & 0xf0) == 0xe0) {
+				if ((p[1] & 0xc0) == 0x80 && (p[2] & 0xc0) == 0x80) {
+					cp = ((uint32_t)(p[0] & 0x0f) << 12) | ((uint32_t)(p[1] & 0x3f) << 6) | (uint32_t)(p[2] & 0x3f);
+					p += 3;
+				} else {
+					cp = *p++;
+				}
+			} else if ((*p & 0xf8) == 0xf0) {
+				if ((p[1] & 0xc0) == 0x80 && (p[2] & 0xc0) == 0x80 && (p[3] & 0xc0) == 0x80) {
+					cp = ((uint32_t)(p[0] & 0x07) << 18) | ((uint32_t)(p[1] & 0x3f) << 12) | ((uint32_t)(p[2] & 0x3f) << 6) | (uint32_t)(p[3] & 0x3f);
+					p += 4;
+				} else {
+					cp = *p++;
+				}
+			} else {
+				cp = *p++;
+			}
+			bj_codepoint(fp, cp);
+		}
+	}
+	fputc('"', fp);
+}
+
+void bj_wstring(FILE *fp, const wchar_t *s, int n)
+{
+	int i;
+
+	fputc('"', fp);
+	if (s) {
+		for (i = 0; i < n; i++) {
+			bj_codepoint(fp, (uint32_t)s[i]);
+		}
+	}
+	fputc('"', fp);
+}
+
+void bj_key(FILE *fp, const char *key)
+{
+	bj_string(fp, key);
+	fputc(':', fp);
+}
+
+void bj_kv_string(FILE *fp, const char *key, const char *value)
+{
+	bj_key(fp, key);
+	bj_string(fp, value);
+}
+
+void bj_kv_int(FILE *fp, const char *key, long value)
+{
+	bj_key(fp, key);
+	fprintf(fp, "%ld", value);
+}
+
+void bj_kv_bool(FILE *fp, const char *key, bool value)
+{
+	bj_key(fp, key);
+	fputs(value ? "true" : "false", fp);
+}
diff --git a/src/bridge-json.h b/src/bridge-json.h
new file mode 100644
index 000000000..e00b887fd
--- /dev/null
+++ b/src/bridge-json.h
@@ -0,0 +1,49 @@
+/**
+ * \file bridge-json.h
+ * \brief Minimal JSON output helpers for the "bridge" front end.
+ *
+ * Copyright (c) 2026 angband3d contributors
+ *
+ * This work is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, version 2.
+ */
+
+#ifndef INCLUDED_BRIDGE_JSON_H
+#define INCLUDED_BRIDGE_JSON_H
+
+#include <stdio.h>
+#include <wchar.h>
+
+/**
+ * Write a JSON string literal, including the surrounding quotes.
+ *
+ * Everything outside printable ASCII is emitted as a \\uXXXX escape, so the
+ * output is valid UTF-8 JSON regardless of the process locale.
+ */
+void bj_string(FILE *fp, const char *s);
+
+/**
+ * As bj_string(), but for a fixed-length wide-character buffer. Values above
+ * the BMP are emitted as surrogate pairs.
+ */
+void bj_wstring(FILE *fp, const wchar_t *s, int n);
+
+/**
+ * Write a single Unicode code point as the body of a JSON string (no quotes).
+ */
+void bj_codepoint(FILE *fp, uint32_t cp);
+
+/** Write "key":"value" */
+void bj_kv_string(FILE *fp, const char *key, const char *value);
+
+/** Write "key":value for a signed integer */
+void bj_kv_int(FILE *fp, const char *key, long value);
+
+/** Write "key":true|false */
+void bj_kv_bool(FILE *fp, const char *key, bool value);
+
+/** Write "key": ready for a caller-supplied raw value */
+void bj_key(FILE *fp, const char *key);
+
+#endif /* INCLUDED_BRIDGE_JSON_H */
diff --git a/src/cmake/macros/BRIDGE_Frontend.cmake b/src/cmake/macros/BRIDGE_Frontend.cmake
new file mode 100644
index 000000000..86bc4945d
--- /dev/null
+++ b/src/cmake/macros/BRIDGE_Frontend.cmake
@@ -0,0 +1,24 @@
+macro(configure_bridge_frontend _NAME_TARGET)
+
+    target_compile_definitions(${_NAME_TARGET} PRIVATE -D USE_BRIDGE)
+
+    if(EMSCRIPTEN)
+        target_link_options(${_NAME_TARGET} PRIVATE
+            "-sASYNCIFY=1"
+            "-sINITIAL_MEMORY=32MB"
+            "-sMAXIMUM_MEMORY=128MB"
+            "-sALLOW_MEMORY_GROWTH=1"
+            "-sFORCE_FILESYSTEM=1"
+            "-lidbfs.js"
+            "-sEXPORTED_RUNTIME_METHODS=['FS','callMain','stringToUTF8','UTF8ToString','addRunDependency','removeRunDependency','IDBFS']"
+            "-sMODULARIZE=1"
+            "-sEXPORT_NAME=createAngbandModule"
+            "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/lib@/lib"
+            "SHELL:--exclude-file *tiles*"
+            "SHELL:--exclude-file *sounds*"
+        )
+    endif()
+
+    message(STATUS "Support for bridge front end - Ready")
+
+endmacro()
diff --git a/src/main-bridge.c b/src/main-bridge.c
new file mode 100644
index 000000000..c67b12b9c
--- /dev/null
+++ b/src/main-bridge.c
@@ -0,0 +1,2149 @@
+/**
+ * \file main-bridge.c
+ * \brief JSON state bridge front end, for driving Angband from an external client.
+ *
+ * Copyright (c) 2026 angband3d contributors
+ *
+ * This work is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, version 2.
+ *
+ * This front end renders nothing. It implements a minimal 80x24 Term, and
+ * whenever the game blocks for input it writes one JSON object describing the
+ * whole visible game state to stdout, then reads one command line from stdin.
+ *
+ * Input is delivered as *keypresses* rather than through cmdq_push(), so the
+ * entire existing UI surface -- birth, menus, stores, item prompts, targeting
+ * and wizard mode -- works through the bridge with no special casing.
+ */
+
+#include "angband.h"
+#include "buildid.h"
+#include "cave.h"
+#include "cmd-core.h"
+#include "game-world.h"
+#include "init.h"
+#include "main.h"
+#include "message.h"
+#include "monster.h"
+#include "mon-desc.h"
+#include "mon-timed.h"
+#include "mon-predicate.h"
+#include "mon-util.h"
+#include "mon-make.h"
+#include "obj-desc.h"
+#include "obj-gear.h"
+#include "object.h"
+#include "player.h"
+#include "player-calcs.h"
+#include "player-timed.h"
+#include "player-util.h"
+#include "target.h"
+#include "ui-display.h"
+#include "ui-map.h"
+#include "ui-game.h"
+#include "ui-input.h"
+#include "ui-output.h"
+#include "ui-term.h"
+#include "bridge-json.h"
+#include "savefile.h"
+#include "z-color.h"
+#include "game-input.h"
+#include "obj-tval.h"
+#include "obj-util.h"
+#include "player-spell.h"
+#include "ui-keymap.h"
+#include "z-quark.h"
+
+#ifdef USE_BRIDGE
+
+#define BRIDGE_PROTOCOL 1
+
+/* Generous upper bounds; values are clamped rather than trusted. */
+#define BRIDGE_MAX_W 1024
+#define BRIDGE_MAX_H 1024
+#define BRIDGE_MAX_ENTITIES 1024
+#define BRIDGE_MAX_MESSAGES 24
+
+struct bridge_entity {
+	int y, x;
+	int attr;
+	wchar_t glyph;
+	uint32_t idx;
+	const struct object_kind *kind;
+};
+
+typedef struct term_data term_data;
+struct term_data { term t; };
+
+static term_data td;
+
+static unsigned long frame_seq = 0;
+static bool emit_map_data = true;
+
+static struct bridge_entity mon_buf[BRIDGE_MAX_ENTITIES];
+static int mon_count;
+static struct bridge_entity obj_buf[BRIDGE_MAX_ENTITIES];
+static int obj_count;
+
+static const char hex_digits[] = "0123456789abcdef";
+
+
+/**
+ * True once there is a generated level with the player actually placed on it.
+ * Frames can be emitted mid-generation or during level transitions, so this
+ * must be checked before any grid-relative lookup.
+ */
+static bool bridge_in_play(void)
+{
+	return character_dungeon && character_generated && cave && player
+		&& player->upkeep && !player->upkeep->generate_level
+		&& square_in_bounds(cave, player->grid);
+}
+
+static struct object *bridge_get_equipped_by_type(struct player *p, int type)
+{
+	if (!p || !p->body.slots) return NULL;
+	for (int i = 0; i < p->body.count; i++) {
+		if (p->body.slots[i].type == type && p->body.slots[i].obj) {
+			return p->body.slots[i].obj;
+		}
+	}
+	return NULL;
+}
+
+
+/**
+ * ------------------------------------------------------------------------
+ * Frame serialisation
+ * ------------------------------------------------------------------------ */
+
+static const char bridge_letters_nohjkl[] = "abcdefgimnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
+
+/**
+ * Compute valid-verb (vm) and invalid-verb (im) bitmasks for an item.
+ * Bit order matches verbBits:
+ * 0:quaff, 1:read, 2:eat, 3:aim, 4:use_staff, 5:zap, 6:activate, 7:fire,
+ * 8:throw, 9:wield, 10:takeoff, 11:drop, 12:inscribe, 13:uninscribe,
+ * 14:refill, 15:browse, 16:study, 17:cast, 18:ignore, 19:examine.
+ */
+static void bridge_obj_verbs(const struct object *obj, bool is_equip, uint32_t *out_vm, uint32_t *out_im)
+{
+	uint32_t vm = 0;
+	uint32_t im = 0;
+
+	if (!player || !obj) {
+		*out_vm = 0;
+		*out_im = 0;
+		return;
+	}
+
+	/* 0: quaff (potion) */
+	if (tval_is_potion(obj)) {
+		vm |= (1 << 0);
+	}
+
+	/* 1: read (scroll) */
+	if (tval_is_scroll(obj)) {
+		if (player_can_read(player, false)) {
+			vm |= (1 << 1);
+		} else {
+			im |= (1 << 1);
+		}
+	}
+
+	/* 2: eat (food/mushroom/edible) */
+	if (tval_is_edible(obj)) {
+		vm |= (1 << 2);
+	}
+
+	/* 3: aim (wand) */
+	if (tval_is_wand(obj)) {
+		if (obj_has_charges(obj)) {
+			vm |= (1 << 3);
+		} else {
+			im |= (1 << 3);
+		}
+	}
+
+	/* 4: use_staff (staff) */
+	if (tval_is_staff(obj)) {
+		if (obj_has_charges(obj)) {
+			vm |= (1 << 4);
+		} else {
+			im |= (1 << 4);
+		}
+	}
+
+	/* 5: zap (rod) */
+	if (tval_is_rod(obj)) {
+		if (obj_can_zap(obj)) {
+			vm |= (1 << 5);
+		} else {
+			im |= (1 << 5);
+		}
+	}
+
+	/* 6: activate */
+	if (obj_is_activatable(obj)) {
+		if (is_equip && obj_can_activate(obj)) {
+			vm |= (1 << 6);
+		} else {
+			im |= (1 << 6);
+		}
+	}
+
+	/* 7: fire (ammo) */
+	if (tval_is_ammo(obj)) {
+		if (obj_can_fire(obj)) {
+			vm |= (1 << 7);
+		} else {
+			im |= (1 << 7);
+		}
+	}
+
+	/* 8: throw */
+	if (obj_can_throw(obj)) {
+		vm |= (1 << 8);
+	}
+
+	/* 9: wield (wear/equip) */
+	if (!is_equip && obj_can_wear(obj)) {
+		vm |= (1 << 9);
+	}
+
+	/* 10: takeoff */
+	if (is_equip) {
+		if (obj_can_takeoff(obj)) {
+			vm |= (1 << 10);
+		} else {
+			im |= (1 << 10);
+		}
+	}
+
+	/* 11: drop */
+	if (!is_equip || obj_can_takeoff(obj)) {
+		vm |= (1 << 11);
+	}
+
+	/* 12: inscribe */
+	vm |= (1 << 12);
+
+	/* 13: uninscribe */
+	if (obj->note != 0) {
+		vm |= (1 << 13);
+	}
+
+	/* 14: refill */
+	if (obj_can_refill(obj)) {
+		vm |= (1 << 14);
+	}
+
+	/* 15: browse */
+	if (obj_can_browse(obj)) {
+		if (player_can_read(player, false)) {
+			vm |= (1 << 15);
+		} else {
+			im |= (1 << 15);
+		}
+	}
+
+	/* 16: study */
+	if (obj_can_browse(obj) && obj_can_study(obj)) {
+		if (player_can_study(player, false)) {
+			vm |= (1 << 16);
+		} else {
+			im |= (1 << 16);
+		}
+	}
+
+	/* 17: cast */
+	if (obj_can_browse(obj) && obj_can_cast_from(obj)) {
+		if (player_can_cast(player, false)) {
+			vm |= (1 << 17);
+		} else {
+			im |= (1 << 17);
+		}
+	}
+
+	/* 18: ignore */
+	vm |= (1 << 18);
+
+	/* 19: examine */
+	vm |= (1 << 19);
+
+	*out_vm = vm;
+	*out_im = im;
+}
+
+static void emit_player(FILE *fp)
+{
+	if (!bridge_in_play() || !player || !player->upkeep) {
+		fputs("null", fp);
+		return;
+	}
+
+	fputc('{', fp);
+	bj_kv_string(fp, "name", player->full_name);
+	fputc(',', fp);
+	bj_kv_string(fp, "race", player->race ? player->race->name : "");
+	fputc(',', fp);
+	bj_kv_string(fp, "class", player->class ? player->class->name : "");
+	fputc(',', fp);
+	bj_kv_string(fp, "history", player->history ? player->history : "");
+	fputc(',', fp);
+	bj_kv_int(fp, "y", player->grid.y);
+	fputc(',', fp);
+	bj_kv_int(fp, "x", player->grid.x);
+	fputc(',', fp);
+	bj_kv_int(fp, "depth", player->depth);
+	fputc(',', fp);
+	bj_kv_int(fp, "max_depth", player->max_depth);
+	fputc(',', fp);
+	bj_kv_int(fp, "level", player->lev);
+	fputc(',', fp);
+	bj_kv_int(fp, "max_lev", player->max_lev);
+	fputc(',', fp);
+	bj_kv_int(fp, "ht", player->ht);
+	fputc(',', fp);
+	bj_kv_int(fp, "wt", player->wt);
+	fputc(',', fp);
+	bj_kv_int(fp, "exp", player->exp);
+	fputc(',', fp);
+	bj_kv_int(fp, "exp_max", player->max_exp);
+	fputc(',', fp);
+	long exp_next = (player->lev >= PY_MAX_LEVEL)
+		? (long)player->exp
+		: ((player->lev >= 1)
+			? (long)(player_exp[player->lev - 1] * player->expfact / 100L)
+			: 0L);
+	bj_kv_int(fp, "exp_next", exp_next);
+	fputc(',', fp);
+	bj_kv_int(fp, "gold", player->au);
+	fputc(',', fp);
+	bj_kv_int(fp, "hp", player->chp);
+	fputc(',', fp);
+	bj_kv_int(fp, "hp_max", player->mhp);
+	fputc(',', fp);
+	bj_kv_int(fp, "sp", player->csp);
+	fputc(',', fp);
+	bj_kv_int(fp, "sp_max", player->msp);
+	fputc(',', fp);
+	bj_kv_int(fp, "ac", player->known_state.ac + player->known_state.to_a);
+	fputc(',', fp);
+	bj_kv_int(fp, "ac_base", player->known_state.ac);
+	fputc(',', fp);
+	bj_kv_int(fp, "ac_to_a", player->known_state.to_a);
+	fputc(',', fp);
+	bj_kv_int(fp, "study", player->upkeep->new_spells);
+	fputc(',', fp);
+	bj_kv_int(fp, "resting", player_is_resting(player) ? player_resting_count(player) : 0);
+	fputc(',', fp);
+	bj_kv_int(fp, "word_recall", player->word_recall);
+	fputc(',', fp);
+	bj_kv_int(fp, "deep_descent", player->deep_descent);
+	fputc(',', fp);
+	/* Player's own light radius (torch/lantern) - drives client torch. */
+	bj_kv_int(fp, "light", player->state.cur_light);
+	fputc(',', fp);
+	/* Currently equipped light item (if any) */
+	struct object *light_obj = bridge_get_equipped_by_type(player, EQUIP_LIGHT);
+	if (light_obj) {
+		char lbuf[80];
+		object_desc(lbuf, sizeof(lbuf), light_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "light_item", lbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "light_fuel", light_obj->timeout);
+		fputc(',', fp);
+	}
+	/* Currently equipped weapon, bow, and shield items */
+	struct object *weap_obj = bridge_get_equipped_by_type(player, EQUIP_WEAPON);
+	if (weap_obj) {
+		char wbuf[80];
+		object_desc(wbuf, sizeof(wbuf), weap_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "weapon_item", wbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "weapon_tval", weap_obj->tval);
+		fputc(',', fp);
+		bj_kv_int(fp, "weapon_sval", weap_obj->sval);
+		fputc(',', fp);
+	}
+	struct object *bow_obj = bridge_get_equipped_by_type(player, EQUIP_BOW);
+	if (bow_obj) {
+		char bbuf[80];
+		object_desc(bbuf, sizeof(bbuf), bow_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "bow_item", bbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "bow_tval", bow_obj->tval);
+		fputc(',', fp);
+		bj_kv_int(fp, "bow_sval", bow_obj->sval);
+		fputc(',', fp);
+	}
+	struct object *shield_obj = bridge_get_equipped_by_type(player, EQUIP_SHIELD);
+	if (shield_obj) {
+		char shbuf[80];
+		object_desc(shbuf, sizeof(shbuf), shield_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "shield_item", shbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "shield_tval", shield_obj->tval);
+		fputc(',', fp);
+		bj_kv_int(fp, "shield_sval", shield_obj->sval);
+		fputc(',', fp);
+	}
+	struct object *body_obj = bridge_get_equipped_by_type(player, EQUIP_BODY_ARMOR);
+	if (body_obj) {
+		char armbuf[80];
+		object_desc(armbuf, sizeof(armbuf), body_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "body_armor_item", armbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "body_armor_tval", body_obj->tval);
+		fputc(',', fp);
+		bj_kv_int(fp, "body_armor_sval", body_obj->sval);
+		fputc(',', fp);
+	}
+	struct object *gloves_obj = bridge_get_equipped_by_type(player, EQUIP_GLOVES);
+	if (gloves_obj) {
+		char glbuf[80];
+		object_desc(glbuf, sizeof(glbuf), gloves_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "gloves_item", glbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "gloves_tval", gloves_obj->tval);
+		fputc(',', fp);
+		bj_kv_int(fp, "gloves_sval", gloves_obj->sval);
+		fputc(',', fp);
+	}
+	if (player->upkeep && player->upkeep->quiver && z_info) {
+		for (int q = 0; q < z_info->quiver_size; q++) {
+			struct object *q_obj = player->upkeep->quiver[q];
+			if (q_obj) {
+				char qbuf[80];
+				object_desc(qbuf, sizeof(qbuf), q_obj, ODESC_BASE, player);
+				bj_kv_string(fp, "quiver_item", qbuf);
+				fputc(',', fp);
+				bj_kv_int(fp, "quiver_tval", q_obj->tval);
+				fputc(',', fp);
+				bj_kv_int(fp, "quiver_sval", q_obj->sval);
+				fputc(',', fp);
+				break;
+			}
+		}
+	}
+	/*
+	 * Ambient light of the square the player stands on. Every grid-relative
+	 * lookup must go through bridge_in_play(): during birth and level
+	 * generation `cave` can be stale or only partly built, and reading it
+	 * then kills the process mid-frame.
+	 */
+	bj_kv_int(fp, "grid_light",
+		bridge_in_play() ? square_light(cave, player->grid) : 0);
+	fputc(',', fp);
+	bj_kv_int(fp, "speed", player->state.speed);
+	fputc(',', fp);
+	bj_kv_bool(fp, "dead", player->is_dead);
+	fputc(',', fp);
+	bj_kv_string(fp, "died_from", player->died_from);
+	fputc(',', fp);
+	bj_kv_bool(fp, "wizard", player->wizard);
+	fputc(',', fp);
+	/* Non-zero once wizard/debug mode has been used: scores are void. */
+	bj_kv_int(fp, "noscore", player->noscore);
+	fputc(',', fp);
+
+	/* Stats: STR, INT, WIS, DEX, CON */
+	bj_key(fp, "stats");
+	fputc('{', fp);
+	const char *stat_keys[STAT_MAX] = { "str", "int", "wis", "dex", "con" };
+	for (int i = 0; i < STAT_MAX; i++) {
+		if (i) fputc(',', fp);
+		bj_key(fp, stat_keys[i]);
+		fputc('{', fp);
+		bj_kv_int(fp, "use", player->state.stat_use[i]);
+		fputc(',', fp);
+		bj_kv_int(fp, "max", player->stat_max[i]);
+		fputc(',', fp);
+		bj_kv_int(fp, "top", player->state.stat_top[i]);
+		fputc(',', fp);
+		bj_kv_bool(fp, "reduced", player->stat_cur[i] < player->stat_max[i]);
+		fputc('}', fp);
+	}
+	fputc('}', fp);
+	fputc(',', fp);
+
+	/* Active status condition badges */
+	bj_key(fp, "statuses");
+	fputc('[', fp);
+	bool has_stat = false;
+	for (int i = 0; i < TMD_MAX; i++) {
+		if (player->timed[i]) {
+			struct timed_grade *grade = timed_effects[i].grade;
+			while (grade && player->timed[i] > grade->max) {
+				grade = grade->next;
+			}
+			if (!grade || !grade->name || !grade->name[0]) continue;
+			if (has_stat) fputc(',', fp);
+			has_stat = true;
+			fputc('{', fp);
+			bj_kv_string(fp, "name", grade->name);
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", grade->color);
+			fputc(',', fp);
+			bj_kv_int(fp, "val", player->timed[i]);
+			fputc('}', fp);
+		}
+	}
+	if (player->state.speed != 110) {
+		if (has_stat) fputc(',', fp);
+		has_stat = true;
+		fputc('{', fp);
+		char sbuf[32];
+		if (player->state.speed > 110) {
+			snprintf(sbuf, sizeof(sbuf), "Fast (+%d)", player->state.speed - 110);
+			bj_kv_string(fp, "name", sbuf);
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", COLOUR_L_GREEN);
+		} else {
+			snprintf(sbuf, sizeof(sbuf), "Slow (-%d)", 110 - player->state.speed);
+			bj_kv_string(fp, "name", sbuf);
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", COLOUR_L_UMBER);
+		}
+		fputc(',', fp);
+		bj_kv_int(fp, "val", player->state.speed);
+		fputc('}', fp);
+	}
+	if (player_is_resting(player)) {
+		if (has_stat) fputc(',', fp);
+		has_stat = true;
+		fputc('{', fp);
