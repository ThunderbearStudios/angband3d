+static void emit_ui(FILE *fp)
+{
+	int overlay = screen_save_depth;
+	const char *context = "dungeon";
+	bool in_dungeon = inkey_flag && bridge_in_play() && (overlay == 0) && (prompt_stack_depth == 0);
+
+	if (!character_generated) {
+		context = "birth";
+		overlay = 1;
+	} else if (player && player->is_dead) {
+		context = "death";
+		overlay = 1;
+	} else if (overlay > 0) {
+		context = "menu";
+	} else {
+		context = "dungeon";
+	}
+
+	fputc('{', fp);
+	/* Non-zero when a screen has been pushed: menu, store, character sheet. */
+	bj_kv_int(fp, "overlay", overlay);
+	fputc(',', fp);
+	/* True only when strictly awaiting a command in the dungeon. */
+	bj_kv_bool(fp, "awaiting_command", in_dungeon);
+	fputc(',', fp);
+	bj_kv_bool(fp, "more", msg_flag);
+	fputc(',', fp);
+	bj_kv_string(fp, "context", context);
+
+	/* ui.prompt: structured prompt state */
+	fputc(',', fp);
+	bj_key(fp, "prompt");
+	if (in_dungeon && !msg_flag && (overlay == 0) && (prompt_stack_depth == 0)) {
+		fputs("null", fp);
+	} else {
+		const char *kind = "unknown";
+		const char *text = "";
+		const char *verb = "";
+		const char *src = "hook";
+		char row0[160];
+
+		if (prompt_stack_depth > 0) {
+			int idx = (prompt_stack_depth <= BRIDGE_PROMPT_STACK_MAX) ? prompt_stack_depth - 1 : BRIDGE_PROMPT_STACK_MAX - 1;
+			kind = prompt_stack[idx].kind;
+			text = prompt_stack[idx].text;
+			verb = prompt_stack[idx].verb;
+			src = prompt_stack[idx].src;
+		} else if (msg_flag) {
+			kind = "more";
+			text = "";
+			verb = "";
+			src = "hook";
+		} else {
+			bridge_get_row0_text(row0, sizeof(row0));
+			text = row0;
+			src = "row0";
+			if (strstr(row0, "Command for")) {
+				kind = "menu";
+			} else if (cave && player && square_in_bounds(cave, player->grid) && square_isshop(cave, player->grid)) {
+				kind = "store";
+			} else if (overlay > 0) {
+				kind = "menu";
+			} else {
+				kind = "unknown";
+			}
+		}
+
+		fputc('{', fp);
+		bj_kv_string(fp, "kind", kind);
+		fputc(',', fp);
+		bj_kv_string(fp, "text", text);
+		fputc(',', fp);
+		bj_kv_string(fp, "verb", verb);
+		fputc(',', fp);
+		bj_kv_string(fp, "src", src);
+		fputc('}', fp);
+	}
+
+	/* Evaluates prereq for primary commands when awaiting a command */
+	if (in_dungeon) {
+		uint64_t avail = 0;
+		int bit = 0;
+		for (int g = 0; g < 5; g++) {
+			struct command_list *cl = &cmds_all[g];
+			if (!cl || !cl->list) continue;
+			for (size_t c = 0; c < cl->len; c++) {
+				if (bit < 64) {
+					if (bridge_eval_cmd_prereq(&cl->list[c])) {
+						avail |= ((uint64_t)1 << bit);
+					}
+					bit++;
+				}
+			}
+		}
+		fputc(',', fp);
+		bj_key(fp, "cmd_avail");
+		fprintf(fp, "%llu", (unsigned long long)avail);
+	}
+
+	fputc('}', fp);
+}
