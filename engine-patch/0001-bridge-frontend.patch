+static void format_key_spec(char *buf, size_t len, keycode_t key)
+{
+	if (!key) {
+		buf[0] = '\0';
+		return;
+	}
+	if (key == ' ') {
+		my_strcpy(buf, "space", len);
+	} else if (key == KC_TAB) {
+		my_strcpy(buf, "tab", len);
+	} else if (key == KC_ENTER) {
+		my_strcpy(buf, "enter", len);
+	} else if (key == ESCAPE) {
+		my_strcpy(buf, "escape", len);
+	} else if (key < 0x20) {
+		buf[0] = 'C';
+		buf[1] = '-';
+		buf[2] = (char)(key + 'a' - 1);
+		buf[3] = '\0';
+	} else if (key < 127) {
+		buf[0] = (char)key;
+		buf[1] = '\0';
+	} else {
+		buf[0] = '\0';
+	}
+}
