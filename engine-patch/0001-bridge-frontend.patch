+		bj_kv_int(fp, "val", player->deep_descent);
+		fputc('}', fp);
+	}
+	if (bridge_in_play() && square_isdtrap(cave, player->grid)) {
+		if (has_stat) fputc(',', fp);
+		has_stat = true;
+		fputc('{', fp);
+		bj_kv_string(fp, "name", "DTrap");
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", square_dtrap_edge(cave, player->grid) ? COLOUR_YELLOW : COLOUR_L_GREEN);
+		fputc(',', fp);
+		bj_kv_int(fp, "val", 1);
+		fputc('}', fp);
+	}
+	fputc(']', fp);
+
+	/* Target / Tracked Monster */
+	struct monster *target_mon = player->upkeep->health_who;
+	if (!target_mon && target_is_set()) {
+		target_mon = target_get_monster();
+	}
+	if (target_mon && monster_is_visible(target_mon) && target_mon->hp >= 0 && !player->timed[TMD_IMAGE]) {
+		fputc(',', fp);
+		bj_key(fp, "target");
