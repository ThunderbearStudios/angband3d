+/**
+ * Emit a frame, then block until the client sends something that produces a
+ * keypress. EOF on stdin ends the game cleanly.
+ */
+static errr bridge_pump(void)
+{
+	char buf[2048];
+
+	if (save_pending && bridge_in_play() && (!player || !player->is_dead) && savefile[0]) {
+		save_pending = false;
+		bool ok = savefile_save(savefile);
+		emit_event("ok", ok ? "saved" : "save_failed");
+	}
+
+	emit_frame();
+
+	for (;;) {
+#ifdef __EMSCRIPTEN__
+		if (wasm_bridge_get_command(buf, sizeof(buf)) <= 0) {
+			emit_event("bye", "eof");
+			quit(NULL);
+			return -1;
+		}
+#else
+		if (!fgets(buf, sizeof(buf), stdin)) {
+			emit_event("bye", "eof");
+			quit(NULL);
+			return -1;
+		}
+#endif
+		if (strchr(buf, '\n')) *strchr(buf, '\n') = '\0';
+		if (strchr(buf, '\r')) *strchr(buf, '\r') = '\0';
+
+		if (bridge_handle(buf) > 0) return 0;
+	}
+}
